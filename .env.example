# Leave empty in production so the SPA uses same-origin /api on Render.
# Same-origin is required for the httpOnly admin session cookie.
VITE_API_BASE=

# Admin login (required in production)
# Set ADMIN_USER so login requires both username and password.
ADMIN_USER=
ADMIN_PASSWORD=
# Long random string (32+ characters) — signs the httpOnly qm_admin session cookie.
# Never reuse the placeholder value.
JWT_SECRET=

# Supabase (required in production — secret key stays server-side only)
# Use the new secret key from Project Settings → API (sb_secret_...), not the legacy service_role JWT.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase Auth — needed so the browser can sign in via email/password,
# magic links, or Google OAuth. The anon key is safe to expose (meant for
# the browser). Take it from Project Settings → API → "anon" / "publishable".
SUPABASE_ANON_KEY=

# ---------- Confluence integration (optional) ----------
# Only needed if you want Cloud OAuth. Data Center works with just a PAT
# pasted in the admin UI and needs nothing set here.
#
# Register an OAuth 2.0 (3LO) app at:
#   https://developer.atlassian.com/console/myapps/
# Grant it these scopes (or a superset):
#   read:confluence-content.summary
#   read:confluence-content.all
#   read:confluence-space.summary
#   search:confluence
#   offline_access
# Set the callback URL to <your-app>/api/confluence/callback/cloud
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_REDIRECT_URI=

# Optional override of default scopes (space- or comma-separated).
CONFLUENCE_SCOPES=

# Encryption key for Confluence tokens stored in Supabase.
# 32 bytes hex, base64, or any string >= 32 chars. If unset, the key is
# derived from JWT_SECRET (rotating JWT_SECRET will invalidate stored tokens
# and admins will need to reconnect).
CONFLUENCE_ENCRYPTION_KEY=
